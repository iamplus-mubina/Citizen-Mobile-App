{
  "expo": {
    "name": "Citizen E-Connect",
    "slug": "oms-mobile-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/citizen_logo.png",
    "scheme": "omsmobileapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "googleServicesFile": "./GoogleService-Info.plist"
    },
    "android": {
      "package": "com.oms.citizen",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/citizen_logo.png",
        "backgroundColor": "#182641"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/citizen_logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/citizen_logo.png",
          "resizeMode": "contain",
          "backgroundColor": "#182641"
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/citizen_logo.png",
          "color": "#182641"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
